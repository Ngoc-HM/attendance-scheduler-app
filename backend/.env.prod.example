# Copy to .env.prod next to docker-compose.prod.yml and fill in every secret.
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=prod
SECRET_KEY=
POSTGRES_PASSWORD=
# Used only to create the seed admin while no active admin exists.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_RESET_ON_STARTUP=false
AUTO_CREATE_TABLES=false
# The desktop client does not send an Origin header; list the server's own
# address so the setting is explicit (prod refuses *).
BACKEND_CORS_ORIGINS=http://160.187.228.64
TIMEZONE=Europe/Berlin
AUTORUN_ENABLED=true
