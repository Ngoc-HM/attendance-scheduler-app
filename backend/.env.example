# Copy to .env and adjust. Never commit the real .env (it holds secrets).
# Every setting of app/core/config.py is listed here with its default.
#
# ENVIRONMENT=dev enables local conveniences (seed-admin password reset, no
# leave-registration window, unrestricted schedule months, CREATE DATABASE
# when missing, /docs). staging and prod are treated the same: they disable
# them AND refuse to start while SECRET_KEY / FIRST_ADMIN_PASSWORD still hold
# the dev defaults or are too short, DATABASE_URL is SQLite or the default
# below, BACKEND_CORS_ORIGINS contains *, AUTO_CREATE_TABLES is true, or the
# retention settings are below 24 months. /docs is served in dev only.
ENVIRONMENT=dev
PROJECT_NAME=Attendance & Auto-Scheduler API
API_V1_STR=/api/v1

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# staging/prod need at least 32 characters.
SECRET_KEY=please-generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin (F-01). Created on startup only while no active admin exists
# (a seed admin deleted on purpose is not recreated). In dev the password is
# reset to this value on every startup (FIRST_ADMIN_RESET_ON_STARTUP); in
# staging/prod an existing admin is never touched and the password must be
# >= 12 characters.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_FULL_NAME=System Administrator
FIRST_ADMIN_RESET_ON_STARTUP=true
# Create the tables of a brand-new, empty database on startup (dev only;
# staging/prod refuse true). Ignored (with a warning) once the database has an
# alembic_version table: then run 'alembic upgrade head' before every start of
# new code — it never adds columns or constraints to existing tables.
AUTO_CREATE_TABLES=true

# Database (use an EU/Frankfurt-region PostgreSQL in production — spec §9.4).
# A '%' in the password is fine (escaped for Alembic).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendance

# CORS (comma-separated list of origins, or * for dev only)
BACKEND_CORS_ORIGINS=*

# i18n + locale. TIMEZONE must be a known IANA zone (checked at startup in
# every environment); every business date (leave window, autorun, time clock)
# is computed in it.
DEFAULT_LANGUAGE=en
TIMEZONE=Europe/Berlin

# GDPR posture (spec §9.4 / §9.6) — informational flags.
DATA_REGION=eu-central-1
SCHEDULER_IS_RULE_BASED=true

# Scheduler. The solve runs in two phases (rule slack first, then the soft
# objectives) within SOLVER_MAX_TIME_SECONDS. SOLVER_NUM_WORKERS is the fixed
# CP-SAT worker count (>= 1); with 1 the same input gives the same plan
# whenever the solve finishes inside the time limit.
SOLVER_MAX_TIME_SECONDS=30
SOLVER_NUM_WORKERS=8
# Holidays worked before this date do not earn a comp day (CD); comp days
# taken before it only pay back comp earned before it.
HOLIDAY_COMP_EFFECTIVE_FROM=2026-11-06
# Keep true on exactly ONE backend per database.
AUTORUN_ENABLED=true
# AUTORUN_DAY=20: the monthly leave window closes at the end of day 20; the
# next month's draft schedule is generated automatically at 00:05 on day 21
# (TIMEZONE local time). Allowed range 1-27, so the day after always exists.
# Missed runs catch up: any later day of the month (daily check and at
# startup) generates the draft while the next month has no schedule.
AUTORUN_DAY=20

# Annual leave: days per calendar year a new user starts with (the admin
# edits each person's quota). Placeholder until the customer confirms it.
ANNUAL_LEAVE_DEFAULT_DAYS=30

# Data retention (§9.3): records older than DATA_RETENTION_MONTHS are purged by
# the admin retention endpoint. DATA_RETENTION_MIN_MONTHS may raise the floor
# but never lower it below 24 (ArbZG §16 working-time records).
DATA_RETENTION_MONTHS=36
DATA_RETENTION_MIN_MONTHS=24
