# Copy to .env and adjust. Never commit the real .env (it holds secrets).
#
# ENVIRONMENT=dev enables local conveniences (seed-admin password reset, no
# leave-registration window, unrestricted schedule months). staging/prod
# disable them AND refuse to start while SECRET_KEY / FIRST_ADMIN_PASSWORD
# still hold the dev defaults.
ENVIRONMENT=dev
PROJECT_NAME=Attendance & Auto-Scheduler API
API_V1_STR=/api/v1

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin (F-01). Created on first startup. In dev the password is reset to
# this value on every startup (FIRST_ADMIN_RESET_ON_STARTUP); in staging/prod an
# existing admin is never touched and the password must be >= 12 characters.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_FULL_NAME=System Administrator
FIRST_ADMIN_RESET_ON_STARTUP=true
# Auto-create DB tables on startup (dev convenience). Use Alembic in prod.
AUTO_CREATE_TABLES=true

# Database (use an EU/Frankfurt-region PostgreSQL in production — spec §9.4)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendance

# CORS (comma-separated, or * for dev)
BACKEND_CORS_ORIGINS=*

# i18n + locale
DEFAULT_LANGUAGE=en
TIMEZONE=Europe/Berlin

# Scheduler
SOLVER_MAX_TIME_SECONDS=30
AUTORUN_ENABLED=true
# AUTORUN_DAY=20: the monthly leave window closes at the end of day 20; the
# next month's draft schedule is generated automatically at 00:05 on day 21.
AUTORUN_DAY=20

# Data retention (§9.3): records older than this are purged by the admin
# retention endpoint. Never below 24 (ArbZG §16 working-time records).
DATA_RETENTION_MONTHS=36
